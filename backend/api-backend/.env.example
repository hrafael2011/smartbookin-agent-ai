# Base de datos (asyncpg)
# Host + Postgres en Docker (docker-compose: puerto 5435 -> 5432):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5435/smartbooking
# Dentro de Docker Compose (servicio api-backend):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smartbooking
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/smartbooking

JWT_SECRET_KEY=change-me-in-production

# Registro: false (MVP) activa la cuenta directamente; true exige verificación por correo
REQUIRE_EMAIL_VERIFICATION=false

# Flags de poda MVP (fase 1): false = función diferida post-MVP, código queda en el repo
# Canal de comandos del owner en Telegram (el dueño usa el panel web)
OWNER_CHANNEL_ENABLED=false
# Waitlist con auto-oferta (cancelar solo cancela; sin job de expiración)
WAITLIST_ENABLED=false
# Agenda diaria del owner (8:00) — job no registrado; código queda en background_tasks.py

# Telegram (un solo bot multi-tenant)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# OpenAI / Meta / Sentry (opcional)
# Interruptor único de IA: AI_ENABLED (decisión) + OPENAI_API_KEY (credencial).
# false = solo menú guiado (sin llamadas a OpenAI); la llave queda lista para reactivar.
AI_ENABLED=false
OPENAI_API_KEY=
META_WABA_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
SENTRY_DSN=

ALLOWED_ORIGINS=http://localhost:5173

# Enlaces en correos (verificación)
FRONTEND_BASE_URL=http://localhost:5173

# SMTP (vacío = solo log del enlace en servidor)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_USE_TLS=true

# Límites diarios por usuario-negocio (optimización tokens)
TG_DAILY_TOTAL_LIMIT=40
TG_DAILY_AI_LIMIT=12
# Pruebas: true desactiva cuotas Telegram/WhatsApp y el rate limit HTTP por IP
DISABLE_USAGE_LIMITS=false
# Contador diario persistente en archivo (fase 4: sin Redis)
# RATE_LIMIT_STATE_FILE=/tmp/smartbooking_daily_quotas.json

# Cron externo (fase 4): true = sin APScheduler; Railway dispara /internal/jobs/*
CRON_EXTERNAL=false
# Token Bearer de los endpoints internos de cron
INTERNAL_CRON_TOKEN=
# Zona horaria del negocio
TIMEZONE=America/Santo_Domingo
