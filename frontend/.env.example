# API: en desarrollo usar /api + proxy en vite.config (evita CORS). En build Docker: /api
VITE_API_URL=/api
# Target del proxy de dev: api-backend del compose (sin nginx desde MVP fase 2); cambiá si usás otro puerto
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

